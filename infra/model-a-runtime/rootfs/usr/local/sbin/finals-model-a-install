#!/usr/bin/env python3
import json
import os
import pwd
import secrets
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path, PurePosixPath

sys.path.insert(0, "/usr/local/lib/finals-model-a")

from model_a import (
    BASE_IMAGES,
    SERVICES,
    SERVICE_BY_SLUG,
    SOURCE_COMMIT,
    ModelAError,
    proxy_config,
    read_json,
    run,
    sha256_file,
    verify_player_bundle,
)


STATE_ROOT = Path("/var/lib/finals-model-a")
WORK_ROOT = Path("/opt/finals/services")
DATA_ROOT = Path("/srv/finals/service-data")
RELEASE_CONFIG = Path("/etc/finals-release")


def atomic_text(path, value, mode):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def validate_release(root):
    release = read_json(root / "release.json")
    if set(release) != {
        "schema_version",
        "source_commit",
        "services",
        "base_images",
        "archives",
    }:
        raise ModelAError("release manifest fields are invalid")
    if release["schema_version"] != 1 or release["source_commit"] != SOURCE_COMMIT:
        raise ModelAError("release manifest identity is invalid")
    archives = release["archives"]
    expected_archives = {"player-bundles.tar", "factory-images.tar", "base-images.tar"}
    if not isinstance(archives, dict) or set(archives) != expected_archives:
        raise ModelAError("release archive inventory is invalid")
    for name, record in archives.items():
        path = root / "archives" / name
        if not isinstance(record, dict) or set(record) != {"sha256", "bytes"}:
            raise ModelAError(f"invalid archive record for {name}")
        info = path.lstat()
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_size != record["bytes"]
            or sha256_file(path) != record["sha256"]
        ):
            raise ModelAError(f"archive verification failed for {name}")
    records = release["services"]
    if not isinstance(records, list) or {
        record.get("slug") for record in records if isinstance(record, dict)
    } != set(SERVICE_BY_SLUG):
        raise ModelAError("release service inventory is invalid")
    expected_service_fields = {
        "slug",
        "port",
        "uid",
        "factory_reference",
        "factory_image_id",
        "bundle_sha256",
        "storage_bytes",
        "storage_inodes",
    }
    for record in records:
        if set(record) != expected_service_fields:
            raise ModelAError("release service fields are invalid")
        service = SERVICE_BY_SLUG[record["slug"]]
        expected = {
            name: service[name]
            for name in ("port", "uid", "storage_bytes", "storage_inodes")
        }
        if any(record[name] != value for name, value in expected.items()):
            raise ModelAError(f"release service contract mismatch for {record['slug']}")
        if (
            not isinstance(record["factory_image_id"], str)
            or not record["factory_image_id"].startswith("sha256:")
            or len(record["factory_image_id"]) != 71
        ):
            raise ModelAError(
                f"release factory image ID is invalid for {record['slug']}"
            )
    bases = release["base_images"]
    if not isinstance(bases, list) or [
        record.get("reference") for record in bases if isinstance(record, dict)
    ] != list(BASE_IMAGES):
        raise ModelAError("release base image inventory is invalid")
    return release


def safe_extract(archive_path, destination):
    allowed = set(SERVICE_BY_SLUG)
    with tarfile.open(archive_path, "r") as archive:
        members = archive.getmembers()
        for member in members:
            relative = PurePosixPath(member.name)
            if (
                relative.is_absolute()
                or ".." in relative.parts
                or len(relative.parts) < 1
                or relative.parts[0] != "services"
            ):
                raise ModelAError("player archive contains an unsafe path")
            if len(relative.parts) >= 2 and relative.parts[1] not in allowed:
                raise ModelAError("player archive contains an unknown service")
            if not (member.isdir() or member.isreg()):
                raise ModelAError("player archive contains a non-file entry")
        for member in members:
            relative = PurePosixPath(member.name)
            target = destination.joinpath(*relative.parts)
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
                target.chmod(0o755)
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            source = archive.extractfile(member)
            if source is None:
                raise ModelAError("player archive file is unreadable")
            with target.open("xb") as output:
                shutil.copyfileobj(source, output)
            target.chmod(0o755 if member.mode & 0o111 else 0o644)


def verify_storage(release):
    result = run(
        [
            "findmnt",
            "--json",
            "--output",
            "TARGET,FSTYPE,OPTIONS",
            "--target",
            str(DATA_ROOT),
        ],
        capture_output=True,
        text=True,
    )
    try:
        filesystems = json.loads(result.stdout)["filesystems"]
    except (KeyError, TypeError, json.JSONDecodeError) as error:
        raise ModelAError("production data mount inspection failed") from error
    if (
        len(filesystems) != 1
        or filesystems[0].get("target") != str(DATA_ROOT)
        or filesystems[0].get("fstype") != "xfs"
    ):
        raise ModelAError("production data mount is not the fixed XFS volume")
    options = set(filesystems[0].get("options", "").split(","))
    if not options.intersection({"prjquota", "pquota"}):
        raise ModelAError("production data mount lacks project quotas")
    state = run(
        ["xfs_quota", "-x", "-c", "state -p", str(DATA_ROOT)],
        capture_output=True,
        text=True,
    ).stdout.lower()
    if "project quota state" not in state or "enforcement: on" not in state:
        raise ModelAError("project quota enforcement is not active")
    for record in release["services"]:
        service = SERVICE_BY_SLUG[record["slug"]]
        data_path = DATA_ROOT / str(record["port"]) / "live"
        if data_path.is_symlink() or not data_path.is_dir():
            raise ModelAError(f"missing fixed live data directory for {record['slug']}")
        run(
            [
                "xfs_quota",
                "-x",
                "-c",
                f"limit -p bhard={record['storage_bytes']}b ihard={record['storage_inodes']} finals-{record['port']}-live",
                str(DATA_ROOT),
            ]
        )
        ensure_instance_secret(data_path, service)


def replace_tree(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    staged = destination.parent / f".{destination.name}.new.{os.getpid()}"
    previous = destination.parent / f".{destination.name}.old.{os.getpid()}"
    shutil.rmtree(staged, ignore_errors=True)
    shutil.rmtree(previous, ignore_errors=True)
    shutil.copytree(source, staged, symlinks=False)
    if destination.exists():
        if destination.is_symlink() or not destination.is_dir():
            raise ModelAError(f"unsafe existing directory: {destination}")
        os.replace(destination, previous)
    os.replace(staged, destination)
    shutil.rmtree(previous, ignore_errors=True)


def recursive_chown(path, uid, gid):
    if path.is_symlink():
        raise ModelAError(f"unsafe player path: {path}")
    os.chown(path, uid, gid)
    for child in path.rglob("*"):
        if child.is_symlink():
            raise ModelAError(f"unsafe player path: {child}")
        os.chown(child, uid, gid)


def ensure_instance_secret(data_path, service):
    secret_path = data_path / service["secret_name"]
    expected_size = 64 if service["secret_format"] == "hex" else 32
    try:
        info = secret_path.lstat()
    except FileNotFoundError:
        payload = (
            secrets.token_hex(32).encode()
            if service["secret_format"] == "hex"
            else secrets.token_bytes(32)
        )
        descriptor = os.open(
            secret_path,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        try:
            if os.write(descriptor, payload) != len(payload):
                raise ModelAError(f"short instance secret write for {service['slug']}")
            os.fsync(descriptor)
            os.fchown(descriptor, service["uid"], service["uid"])
        finally:
            os.close(descriptor)
        info = secret_path.lstat()
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_uid != service["uid"]
        or info.st_gid != service["uid"]
        or info.st_size != expected_size
    ):
        raise ModelAError(f"unsafe instance secret for {service['slug']}")
    if service["secret_format"] == "hex":
        value = secret_path.read_bytes()
        if any(character not in b"0123456789abcdef" for character in value):
            raise ModelAError(f"invalid instance secret for {service['slug']}")


def image_id(reference):
    result = run(
        ["docker", "image", "inspect", "--format", "{{.Id}}", reference],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def compose(service_root, image, *arguments):
    environment = dict(os.environ)
    environment["H7_IMAGE"] = image
    run(
        [
            "docker",
            "compose",
            "--project-directory",
            str(service_root),
            "-f",
            str(service_root / "compose.yaml"),
            *arguments,
        ],
        env=environment,
    )


def install(release_root, team_number, expected_release_sha256):
    actual_release_sha256 = sha256_file(release_root / "release.json")
    if actual_release_sha256 != expected_release_sha256:
        raise ModelAError("release manifest digest mismatch")
    release = validate_release(release_root)
    verify_storage(release)
    run(
        [
            "docker",
            "image",
            "load",
            "--input",
            str(release_root / "archives" / "base-images.tar"),
        ]
    )
    run(
        [
            "docker",
            "image",
            "load",
            "--input",
            str(release_root / "archives" / "factory-images.tar"),
        ]
    )
    for record in release["base_images"]:
        if image_id(record["reference"]) != record["image_id"]:
            raise ModelAError(f"base image ID mismatch for {record['reference']}")
    for record in release["services"]:
        if image_id(record["factory_reference"]) != record["factory_image_id"]:
            raise ModelAError(f"factory image ID mismatch for {record['slug']}")
    extraction = Path(
        tempfile.mkdtemp(prefix=".model-a-payload.", dir=STATE_ROOT.parent)
    )
    try:
        safe_extract(release_root / "archives" / "player-bundles.tar", extraction)
        for record in release["services"]:
            source = extraction / "services" / record["slug"]
            verify_player_bundle(source, record["slug"])
            if sha256_file(source / "BUNDLE.json") != record["bundle_sha256"]:
                raise ModelAError(f"bundle digest mismatch for {record['slug']}")
        account = pwd.getpwnam("ubuntu")
        STATE_ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
        WORK_ROOT.mkdir(parents=True, exist_ok=True, mode=0o755)
        for record in release["services"]:
            slug = record["slug"]
            source = extraction / "services" / slug
            factory = STATE_ROOT / "factory" / slug
            workspace = WORK_ROOT / slug
            replace_tree(source, factory)
            replace_tree(source, workspace)
            factory.chmod(0o700)
            workspace.chmod(0o755)
            for editable in (workspace / "service", workspace / "player"):
                if editable.exists():
                    recursive_chown(editable, account.pw_uid, account.pw_gid)
            (workspace / "compose.yaml").chmod(0o644)
            (workspace / "BUNDLE.json").chmod(0o444)
            atomic_text(
                STATE_ROOT / "active" / slug, record["factory_image_id"] + "\n", 0o600
            )
        atomic_text(
            STATE_ROOT / "release.json",
            json.dumps(release, indent=2, sort_keys=True) + "\n",
            0o600,
        )
    finally:
        shutil.rmtree(extraction, ignore_errors=True)
    RELEASE_CONFIG.mkdir(parents=True, exist_ok=True)
    atomic_text(RELEASE_CONFIG / "haproxy.cfg", proxy_config(team_number), 0o600)
    run(["haproxy", "-c", "-f", str(RELEASE_CONFIG / "haproxy.cfg")])
    for record in release["services"]:
        compose(
            WORK_ROOT / record["slug"],
            record["factory_image_id"],
            "up",
            "--detach",
            "--wait",
            "--wait-timeout",
            "90",
            "service",
        )
    run(["systemctl", "enable", "--now", "finals-service-proxy.service"])


def main():
    if os.geteuid() != 0 or len(sys.argv) != 4:
        print(
            "usage: finals-model-a-install RELEASE_DIRECTORY TEAM_NUMBER RELEASE_SHA256",
            file=sys.stderr,
        )
        return 2
    try:
        team_number = int(sys.argv[2])
        # Team 16 is the NOP exploit-test target and runs the same six services.
        if team_number not in range(1, 17):
            raise ValueError
    except ValueError:
        print("team number must be from 1 to 16", file=sys.stderr)
        return 2
    expected_release_sha256 = sys.argv[3]
    if len(expected_release_sha256) != 64 or any(
        character not in "0123456789abcdef" for character in expected_release_sha256
    ):
        print("release SHA-256 is invalid", file=sys.stderr)
        return 2
    try:
        install(Path(sys.argv[1]).resolve(), team_number, expected_release_sha256)
    except (ModelAError, OSError, KeyError, pwd.error) as error:
        print(f"Model A installation refused: {error}", file=sys.stderr)
        return 1
    print("Model A services installed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
