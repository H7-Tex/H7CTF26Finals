#!/usr/bin/env bash
set -euo pipefail

requested_bundle() {
  local role=${1:-} original=${2:-} bundle
  case "$original" in
    'install gateway-wireguard') bundle=gateway-wireguard ;;
    'install gateway-reconciler') bundle=gateway-reconciler ;;
    'install anvil') bundle=anvil ;;
    'install control-reconciler') bundle=control-reconciler ;;
    'install control-checkers') bundle=control-checkers ;;
    'install repository') bundle=repository ;;
    *) return 1 ;;
  esac
  case "$role:$bundle" in
    gateway:gateway-wireguard | gateway:gateway-reconciler | platform:anvil | control:control-reconciler | control:control-checkers | repository:repository) ;;
    *) return 1 ;;
  esac
  printf '%s\n' "$bundle"
}

host_role() {
  local platform_role router_role
  platform_role=$(cat /etc/finals-platform/role 2>/dev/null || true)
  router_role=$(cat /etc/event-router/role 2>/dev/null || true)
  if [[ -n $platform_role && -n $router_role ]]; then
    return 1
  fi
  case "$platform_role" in
    '{"role":"platform"}') printf 'platform\n' ;;
    '{"role":"control"}') printf 'control\n' ;;
    '{"role":"repository"}') printf 'repository\n' ;;
    '')
      case "$router_role" in
        active | standby) printf 'gateway\n' ;;
        *) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac
}

main() {
  [[ $# -eq 0 ]] || { echo "secret relay receiver takes no arguments" >&2; return 2; }
  local role bundle
  role=$(host_role) || { echo "secret relay receiver: host role is absent or ineligible" >&2; return 1; }
  bundle=$(requested_bundle "$role" "${SSH_ORIGINAL_COMMAND:-}") || {
    echo "secret relay receiver: command or bundle is not authorized for this host" >&2
    return 1
  }
  exec /usr/bin/sudo -n /usr/local/sbin/finals-install-secret-bundle "$bundle"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
