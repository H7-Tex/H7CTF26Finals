#!/usr/bin/env python3
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path, PurePosixPath


def fail(message):
    print(f"mirror preflight: {message}", file=sys.stderr)
    raise SystemExit(1)


def digest_file(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


expected_mode = sys.argv[1] if len(sys.argv) == 2 else "offline"
if expected_mode != "offline":
    fail("only the sealed offline gate is accepted")
if os.geteuid() != 0:
    fail("must run as root")
if subprocess.run(["mountpoint", "-q", "/srv/cache"]).returncode:
    fail("/srv/cache is not a mount point")
label = subprocess.run(["findmnt", "-n", "-o", "LABEL", "-T", "/srv/cache"], check=True, capture_output=True, text=True).stdout.strip()
if label != "cache-data":
    fail("wrong data volume label")

manifest_path = Path("/etc/finals-platform/mirror/preseed-manifest.json")
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except (OSError, UnicodeDecodeError, json.JSONDecodeError):
    fail("reviewed preseed manifest is missing or invalid")
if not isinstance(manifest, dict) or set(manifest) != {"version", "files"} or manifest["version"] != 1:
    fail("preseed manifest schema is invalid")
files = manifest["files"]
if not isinstance(files, list) or not files:
    fail("preseed manifest is empty")

roots = set()
seen = set()
for entry in files:
    if not isinstance(entry, dict) or set(entry) != {"path", "sha256", "size"}:
        fail("preseed entry schema is invalid")
    relative = PurePosixPath(entry["path"])
    if relative.is_absolute() or ".." in relative.parts or len(relative.parts) < 2:
        fail("preseed path escapes the cache root")
    if relative.parts[0] not in {"apt", "pypi", "verdaccio", "registry"}:
        fail("preseed path uses an unknown cache class")
    if entry["path"] in seen or not re.fullmatch(r"[0-9a-f]{64}", entry["sha256"]):
        fail("preseed entry is duplicate or has an invalid digest")
    if not isinstance(entry["size"], int) or entry["size"] < 0:
        fail("preseed entry has an invalid size")
    target = Path("/srv/cache") / relative
    try:
        if not target.is_file() or target.stat().st_size != entry["size"]:
            fail(f"preseed artifact is absent or changed: {entry['path']}")
        digest = digest_file(target)
    except OSError:
        fail(f"preseed artifact cannot be read: {entry['path']}")
    if digest != entry["sha256"]:
        fail(f"preseed digest mismatch: {entry['path']}")
    roots.add(relative.parts[0])
    seen.add(entry["path"])
if roots != {"apt", "pypi", "verdaccio", "registry"}:
    fail("all four cache classes require reviewed artifacts")

mode = Path("/etc/finals-platform/mirror/mode.env")
if mode.read_text(encoding="ascii") != "REGISTRY_MODE=offline\n":
    fail("registry is not sealed read-only")
if "Offlinemode: 1" not in Path("/etc/apt-cacher-ng/acng.conf").read_text(encoding="utf-8"):
    fail("APT cache is not offline")

images = {}
for line in Path("/etc/finals-platform/images.env").read_text(encoding="ascii").splitlines():
    name, value = line.split("=", 1)
    images[name] = value
for name in ("NGINX_IMAGE", "VERDACCIO_IMAGE", "REGISTRY_IMAGE"):
    if not re.search(r"@sha256:[0-9a-f]{64}$", images.get(name, "")):
        fail(f"{name} is not pinned")
    if subprocess.run(["docker", "image", "inspect", images[name]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        fail(f"pinned image is absent: {images[name]}")

print("mirror preflight: ok")
