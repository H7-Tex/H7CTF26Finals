#!/usr/bin/env python3
import hashlib
import json
import os
import re
import sys
from pathlib import Path, PurePosixPath


MANIFEST = Path("/etc/finals-platform/checkers/artifact-manifest.json")
ARTIFACT_ROOT = Path("/opt/finals-checkers")


def fail(message):
    print(f"checker preflight: {message}", file=sys.stderr)
    raise SystemExit(1)


def digest_file(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate(manifest_path=MANIFEST, artifact_root=ARTIFACT_ROOT):
    try:
        document = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("reviewed artifact manifest is missing or invalid")
    if not isinstance(document, dict) or set(document) != {"version", "artifacts"} or document["version"] != 1:
        fail("artifact manifest schema is invalid")
    artifacts = document["artifacts"]
    if not isinstance(artifacts, list) or not artifacts:
        fail("artifact manifest is empty")

    seen = set()
    for entry in artifacts:
        if not isinstance(entry, dict) or set(entry) != {"path", "sha256", "size", "executable"}:
            fail("artifact entry schema is invalid")
        relative = PurePosixPath(entry["path"])
        if relative.is_absolute() or ".." in relative.parts or len(relative.parts) < 2:
            fail("artifact path must name a file below a service directory")
        if entry["path"] in seen or not re.fullmatch(r"[0-9a-f]{64}", entry["sha256"]):
            fail("artifact entry is duplicate or has an invalid digest")
        if not isinstance(entry["size"], int) or entry["size"] < 1 or type(entry["executable"]) is not bool:
            fail("artifact size or executable marker is invalid")
        target = artifact_root / relative
        try:
            if target.is_symlink() or not target.is_file() or target.stat().st_size != entry["size"]:
                fail(f"artifact is absent or changed: {entry['path']}")
            actual_executable = bool(target.stat().st_mode & 0o111)
            digest = digest_file(target)
        except OSError:
            fail(f"artifact cannot be read: {entry['path']}")
        if actual_executable != entry["executable"] or digest != entry["sha256"]:
            fail(f"artifact mode or digest mismatch: {entry['path']}")
        seen.add(entry["path"])


def main():
    if os.geteuid() != 0:
        fail("must run as root")
    validate()
    print("checker preflight: reviewed artifacts are present")


if __name__ == "__main__":
    main()
