#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
role=${1:-}
case "$role" in
  platform | operations | control | repository | mirror | hill-01 | hill-02 | hill-03) ;;
  *) echo "unsupported fixed platform role: $role" >&2; exit 2 ;;
esac

manifest_role=$(python3 -c 'import json; print(json.load(open("/etc/runtime-image.json", encoding="utf-8"))["role"])')
case "$role:$manifest_role" in
  platform:platform-x86 | control:platform-x86 | hill-01:platform-x86 | hill-02:platform-x86 | hill-03:platform-x86 | operations:platform-arm | repository:platform-arm | mirror:platform-arm) ;;
  *) echo "fixed role does not match the immutable image architecture" >&2; exit 1 ;;
esac

role_file=/etc/finals-platform/role
if [[ -e $role_file ]]; then
  [[ $(cat "$role_file") == "{\"role\":\"$role\"}" ]] || { echo "host role is already set differently" >&2; exit 1; }
else
  install -d -m 0755 /etc/finals-platform
  temporary=$(mktemp /etc/finals-platform/.role.XXXXXX)
  printf '{"role":"%s"}\n' "$role" > "$temporary"
  chmod 0644 "$temporary"
  mv "$temporary" "$role_file"
fi

install_relay_sudoers() {
  local temporary bundle
  temporary=$(mktemp /etc/sudoers.d/.finals-secret-relay.XXXXXX)
  for bundle in "$@"; do
    printf 'ubuntu ALL=(root) NOPASSWD: /usr/local/sbin/finals-install-secret-bundle %s\n' "$bundle"
  done > "$temporary"
  chmod 0440 "$temporary"
  visudo -cf "$temporary" >/dev/null
  mv "$temporary" /etc/sudoers.d/finals-secret-relay
}

systemctl enable --now finals-host-firewall.service
case "$role" in
  platform)
    install_relay_sudoers anvil
    for unit in anvil-finals.service anvil-finals-backup.service anvil-finals-backup.timer; do
      install -D -m 0644 "/opt/anvil/current/deployments/finals/$unit" "/etc/systemd/system/$unit"
    done
    systemctl enable finals-volume@anvil.service
    systemctl start finals-volume@anvil.service || true
    ;;
  repository)
    install_relay_sudoers repository
    install -D -m 0644 /dev/null /etc/ssh/sshd_config.d/95-repository-management.conf
    printf 'Port 2222\n' > /etc/ssh/sshd_config.d/95-repository-management.conf
    sshd -t
    systemctl reload ssh.service
    systemctl enable finals-volume@repository.service
    systemctl start finals-volume@repository.service || true
    systemctl disable finals-repository.service >/dev/null 2>&1 || true
    ;;
  mirror)
    systemctl enable finals-volume@mirror.service
    systemctl start finals-volume@mirror.service || true
    systemctl disable finals-mirror.service apt-cacher-ng.service >/dev/null 2>&1 || true
    ;;
  control)
    install_relay_sudoers control-reconciler control-checkers
    grep -Eq '^10\.60\.200\.10[[:space:]]+finals\.h7tex\.com([[:space:]]|$)' /etc/hosts || printf '10.60.200.10 finals.h7tex.com\n' >> /etc/hosts
    systemctl disable peer-reconciler.timer checker-runtime.service finals-checkers-ready.service >/dev/null 2>&1 || true
    ;;
esac
systemctl daemon-reload
systemctl enable finals-platform.target
