[Unit]
Description=Deployment Orchestrator
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/etc/deployment-orchestrator
ConditionPathExists=/etc/deployment-orchestrator/config.json
ConditionPathExists=/etc/deployment-orchestrator/services.json
ConditionPathExists=/etc/deployment-orchestrator/webhook.secret
ConditionPathExists=/etc/deployment-orchestrator/anvil.token
ConditionFileIsExecutable=/usr/local/libexec/deployment-orchestrator/runner
ConditionPathIsDirectory=/var/lib/deployment-orchestrator
ConditionPathIsDirectory=/var/lib/deployment-orchestrator/repository
ConditionPathExists=/var/lib/deployment-orchestrator/state.json
ConditionPathExists=/var/lib/deployment-orchestrator/audit.jsonl

[Service]
Type=simple
User=deploy-orchestrator
Group=deploy-orchestrator
UMask=0077
LoadCredential=config.json:/etc/deployment-orchestrator/config.json
LoadCredential=services.json:/etc/deployment-orchestrator/services.json
LoadCredential=webhook.secret:/etc/deployment-orchestrator/webhook.secret
LoadCredential=anvil.token:/etc/deployment-orchestrator/anvil.token
ExecStartPre=+/usr/local/bin/deployment-orchestrator host-preflight
ExecStartPre=/usr/local/bin/deployment-orchestrator validate --config %d/config.json
ExecStart=/usr/local/bin/deployment-orchestrator serve --config %d/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/deployment-orchestrator
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressAllow=10.60.200.10/32
IPAddressAllow=10.60.201.20/32
IPAddressAllow=10.60.201.30/32

[Install]
WantedBy=multi-user.target
