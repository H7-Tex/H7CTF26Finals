[Unit]
Description=Deployment Executor local control socket

[Socket]
ExecStartPre=/usr/local/libexec/deployment-executor/executor validate
ListenStream=/run/deployment-executor/control.sock
FileDescriptorName=control
SocketUser=root
SocketGroup=deploy-orchestrator
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
