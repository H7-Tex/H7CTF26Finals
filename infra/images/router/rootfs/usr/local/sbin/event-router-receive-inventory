#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import syslog
import tempfile
from pathlib import Path

MAX_INVENTORY_BYTES = 256 * 1024
STATE_DIRECTORY = Path("/var/lib/event-router")
ACTIVE_INVENTORY = STATE_DIRECTORY / "active-peers.json"
STAGED_INVENTORY = STATE_DIRECTORY / "incoming-peers.json"
VALIDATOR = Path("/usr/local/libexec/event-router/render_inventory.py")
APPLY = Path("/usr/local/sbin/event-router-apply-inventory")


class ReceiveError(Exception):
    pass


def atomic_write(path, payload):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as output:
            output.write(payload)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def validate(candidate, active, validator):
    with tempfile.TemporaryDirectory(prefix="peer-receiver-") as directory:
        command = [
            str(validator),
            str(candidate),
            "--wireguard-output",
            f"{directory}/wireguard.conf",
            "--nft-output",
            f"{directory}/peers.nft",
        ]
        if active.exists():
            command.extend(("--active-inventory", str(active)))
        try:
            subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
                timeout=10,
            )
        except (OSError, subprocess.SubprocessError) as error:
            raise ReceiveError("inventory validation failed") from error


def load(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ReceiveError("inventory cannot be read") from error


def receive(stream, active=ACTIVE_INVENTORY, staged=STAGED_INVENTORY, validator=VALIDATOR, apply=APPLY):
    payload = stream.read(MAX_INVENTORY_BYTES + 1)
    if not payload or len(payload) > MAX_INVENTORY_BYTES:
        raise ReceiveError("inventory has an invalid size")

    with tempfile.NamedTemporaryFile(prefix="peer-inventory-", dir=staged.parent, delete=False) as temporary:
        os.fchmod(temporary.fileno(), 0o600)
        temporary.write(payload)
        temporary.flush()
        os.fsync(temporary.fileno())
        candidate = Path(temporary.name)
    try:
        validate(candidate, active, validator)
        inventory = load(candidate)
        if active.exists() and inventory == load(active):
            return "unchanged", inventory["generation"], len(inventory["peers"])
        atomic_write(staged, payload)
        try:
            subprocess.run(
                [str(apply), str(staged)],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
                timeout=30,
            )
        except (OSError, subprocess.SubprocessError) as error:
            raise ReceiveError("inventory apply failed") from error
        return "applied", inventory["generation"], len(inventory["peers"])
    finally:
        candidate.unlink(missing_ok=True)


def main():
    if os.geteuid() != 0:
        raise SystemExit("must run as root")
    if os.environ.get("SSH_ORIGINAL_COMMAND"):
        raise SystemExit("remote commands are not accepted")
    try:
        result, generation, peer_count = receive(sys.stdin.buffer)
    except ReceiveError:
        message = json.dumps({"event": "inventory_rejected"}, sort_keys=True)
        syslog.openlog("peer-inventory")
        syslog.syslog(syslog.LOG_WARNING, message)
        print(message)
        raise SystemExit(1)
    message = json.dumps({
        "event": "inventory_received",
        "generation": generation,
        "peer_count": peer_count,
        "result": result,
    }, sort_keys=True)
    syslog.openlog("peer-inventory")
    syslog.syslog(syslog.LOG_INFO, message)
    print(message)


if __name__ == "__main__":
    main()
