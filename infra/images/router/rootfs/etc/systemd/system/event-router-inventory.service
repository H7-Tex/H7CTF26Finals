[Unit]
Description=Apply the active WireGuard peer inventory
After=nftables.service
Requires=nftables.service
ConditionPathExists=/etc/event-router/peers.json
ConditionPathExists=/etc/wireguard/private.key

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/event-router-apply-inventory /etc/event-router/peers.json
UMask=0077
