#!/usr/bin/env python3
"""Fetch the Model A release for a production image build through a read PAR.

The manifest comes from the build payload: the PAR base URL plus the exact
size and SHA-256 of every object. Nothing is trusted that was not pinned in
the reviewed Terraform inputs. The manifest holds the PAR, so it is deleted
as soon as the fetch is done, before any other phase runs.
"""
import hashlib
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

OBJECTS = {"release.json", "archives/player-bundles.tar", "archives/factory-images.tar", "archives/base-images.tar"}
BASE_URL = re.compile(r"^https://objectstorage\.ap-hyderabad-1\.oraclecloud\.com/p/[A-Za-z0-9_.+=%-]+/n/[a-z0-9]+/b/[A-Za-z0-9_.-]+/o/$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
CHUNK = 1 << 20


def fail(message):
    raise SystemExit(f"model a release: {message}")


def load(path):
    try:
        document = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read manifest: {error.__class__.__name__}")
    if not isinstance(document, dict) or set(document) != {"base_url", "release_sha256", "objects"}:
        fail("manifest must contain only base_url, release_sha256 and objects")
    if not isinstance(document["base_url"], str) or not BASE_URL.fullmatch(document["base_url"]):
        fail("base_url is not a fixed-region object storage PAR")
    if not isinstance(document["release_sha256"], str) or not SHA256.fullmatch(document["release_sha256"]):
        fail("release_sha256 is invalid")
    objects = document["objects"]
    if not isinstance(objects, dict) or set(objects) != OBJECTS:
        fail("objects must be exactly the four release objects")
    for name, item in objects.items():
        if not isinstance(item, dict) or set(item) != {"sha256", "size"}:
            fail(f"{name}: object must contain only sha256 and size")
        if not isinstance(item["sha256"], str) or not SHA256.fullmatch(item["sha256"]):
            fail(f"{name}: sha256 is invalid")
        if type(item["size"]) is not int or not 0 < item["size"] <= 4 << 30:
            fail(f"{name}: size is invalid")
    if objects["release.json"]["sha256"] != document["release_sha256"]:
        fail("release.json hash does not match release_sha256")
    return document


def fetch(url, target, expected_sha256, expected_size):
    partial = target.with_name(target.name + ".partial")
    for attempt in range(1, 6):
        digest = hashlib.sha256()
        size = 0
        try:
            with urllib.request.urlopen(url, timeout=60) as response, open(partial, "wb") as output:
                os.fchmod(output.fileno(), 0o600)
                while chunk := response.read(CHUNK):
                    size += len(chunk)
                    if size > expected_size:
                        break
                    digest.update(chunk)
                    output.write(chunk)
                output.flush()
                os.fsync(output.fileno())
        except OSError as error:
            # never print the url: it carries the par
            print(f"model a release: {target.name} attempt {attempt} failed: {error.__class__.__name__}", file=sys.stderr)
            time.sleep(min(30, 2 ** attempt))
            continue
        if size == expected_size and digest.hexdigest() == expected_sha256:
            os.replace(partial, target)
            return
        print(f"model a release: {target.name} attempt {attempt} failed verification", file=sys.stderr)
    partial.unlink(missing_ok=True)
    fail(f"{target.name} could not be fetched and verified")


def main():
    if len(sys.argv) != 3:
        fail("usage: fetch-model-a-release MANIFEST DESTINATION")
    manifest, destination = Path(sys.argv[1]), Path(sys.argv[2])
    document = load(manifest)
    try:
        destination.mkdir(parents=True, mode=0o700, exist_ok=False)
        (destination / "archives").mkdir(mode=0o700)
        for name in sorted(document["objects"]):
            item = document["objects"][name]
            url = document["base_url"] + urllib.parse.quote(name, safe="/")
            fetch(url, destination / name, item["sha256"], item["size"])
    finally:
        manifest.unlink(missing_ok=True)
    marker = Path("/etc/finals-model-a/release.sha256")
    marker.parent.mkdir(parents=True, mode=0o755, exist_ok=True)
    marker.write_text(document["release_sha256"] + "\n", encoding="ascii")
    marker.chmod(0o644)
    total = sum(item["size"] for item in document["objects"].values())
    print(f"model a release: {len(document['objects'])} objects, {total} bytes verified")


if __name__ == "__main__":
    main()
