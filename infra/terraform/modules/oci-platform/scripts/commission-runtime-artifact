#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 && $(cat /etc/finals-platform/role 2>/dev/null) == '{"role":"operations"}' ]] || exit 1
[[ -f /run/finals-commissioning/central_id_ed25519 && ! -L /run/finals-commissioning/central_id_ed25519 ]] || exit 1
[[ $# -eq 2 ]] || exit 2
target=$1
action=$2
case "$target" in
  control) address=10.60.201.20 ;;
  hill-01) address=10.60.210.11 ;;
  hill-02) address=10.60.210.12 ;;
  hill-03) address=10.60.210.13 ;;
  *) exit 2 ;;
esac
case "$target:$action" in
  control:checker-recover)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'set -euo pipefail
      d=/etc/systemd/system/checker-runtime.service.d/runtime-directory.conf
      h=9eac6ae93b20078389b6048d064fd50a8017edba06cd1b5fbe49a47491a3ce35
      x=$(mktemp /tmp/c.XXXXXX); trap "rm -f -- $x" EXIT
      printf "[Service]\nRuntimeDirectory=checker-runtime\nRuntimeDirectoryMode=0700\n" > "$x"
      sudo -n install -D -o root -g root -m 0644 "$x" "$d"
      [[ $(sudo -n stat -c %U:%G:%a "$d") == root:root:644 ]]
      [[ $(sudo -n sha256sum "$d" | cut -c1-64) == "$h" ]]
      t=(timeout -k2s); r=
      "${t[@]}" 30s sudo -n systemctl daemon-reload || r=1
      "${t[@]}" 10s sudo -n systemctl reset-failed checker-runtime.service || r=1
      "${t[@]}" 180s sudo -n systemctl restart checker-runtime.service >/dev/null 2>&1 || r=1
      : > "$x"
      "${t[@]}" 240s bash -c "until curl -s -o $x -w \"%{http_code}\" --connect-timeout 2 --max-time 3 http://127.0.0.1:9160/readyz | grep -qx 200; do sleep 1; done" || r=1
      cat "$x"; echo
      "${t[@]}" 10s sudo -n systemctl show checker-runtime.service -p SubState,Result,NRestarts || r=1
      [[ -z $r ]] || "${t[@]}" 10s sudo -n journalctl -u checker-runtime.service -n 25 --no-pager -o cat || :
      [[ -z $r ]]
      echo checker-recover=complete'
    ;;
  control:checker-status)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'set -euo pipefail
      if timeout --signal=TERM --kill-after=2s 10s sudo -n systemctl is-active --quiet checker-runtime.service; then checker_runtime=active; else checker_runtime=inactive; fi
      if timeout --signal=TERM --kill-after=2s 10s sudo -n systemctl is-active --quiet peer-reconciler.timer; then reconciler_timer=active; else reconciler_timer=inactive; fi
      readyz_http=$(curl --silent --output /dev/null --write-out "%{http_code}" --connect-timeout 2 --max-time 3 http://127.0.0.1:9160/readyz || true)
      [[ $readyz_http =~ ^[0-9]{3}$ ]] || readyz_http=000
      printf "checker-runtime.service=%s\npeer-reconciler.timer=%s\nreadyz-http=%s\n" "$checker_runtime" "$reconciler_timer" "$readyz_http"
      [[ $checker_runtime == active && $reconciler_timer == active && $readyz_http == 200 ]]
      echo checker-status=complete'
    ;;
  control:state-summary)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'sudo -n /usr/bin/python3 -c '\''import hashlib,json,sys;p=sys.argv[1];b=open(p,"rb").read();v=json.loads(b);print("active-file-sha256="+hashlib.sha256(b).hexdigest());print("active-generation="+str(v["generation"]));print("active-peer-count="+str(len(v["peers"])))'\'' /var/lib/peer-reconciler/active.json'
    ;;
  hill-0[123]:hill-artifacts)
    maximum=385986560
    expected_size=$maximum
    expected_sha256=f3716d884f4ed3ebe5b5c4138d459aa2e35324c0839c5466167d91cd6796cc20
    remote='sudo -n /usr/local/sbin/finals-commission-hill-artifacts'
    directory=/var/tmp
    ;;
  hill-0[123]:hill-config)
    maximum=65536
    expected_size=
    expected_sha256=
    remote='sudo -n /usr/local/sbin/finals-commission-hill-config'
    directory=/run
    ;;
  hill-0[123]:hill-control)
    maximum=65536
    expected_size=
    expected_sha256=
    remote='sudo -n /usr/local/sbin/finals-install-secret-bundle hill-control'
    directory=/run
    ;;
  hill-0[123]:hill-start)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'sudo -n /usr/local/sbin/finals-commission-hill-start'
    ;;
  *) exit 2 ;;
esac
temporary=$(mktemp "$directory/finals-runtime-artifact.XXXXXX")
trap 'find "$temporary" -delete' EXIT
head -c "$((maximum + 1))" > "$temporary"
size=$(stat -c %s "$temporary")
(( size > 0 && size <= maximum ))
[[ -z $expected_size || $size -eq $expected_size ]]
[[ -z $expected_sha256 || $(sha256sum "$temporary" | cut -d ' ' -f 1) == "$expected_sha256" ]]
ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
  -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" "$remote" < "$temporary"
printf '%s:%s=complete\n' "$target" "$action"
