#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 && $(cat /etc/finals-platform/role 2>/dev/null) == '{"role":"operations"}' ]] || exit 1
[[ -f /run/finals-commissioning/central_id_ed25519 && ! -L /run/finals-commissioning/central_id_ed25519 ]] || exit 1
[[ $# -eq 2 ]] || exit 2
target=$1
action=$2
case "$target" in
  platform) address=10.60.200.10 ;;
  control) address=10.60.201.20 ;;
  hill-01) address=10.60.210.11 ;;
  hill-02) address=10.60.210.12 ;;
  hill-03) address=10.60.210.13 ;;
  *) exit 2 ;;
esac
case "$target:$action" in
  platform:anvil-deploy)
    maximum=536870912
    mapfile -t request
    [[ ${#request[@]} -eq 5 ]]
    revision=${request[0]}
    expected_size=${request[1]}
    expected_sha256=${request[2]}
    expected_game_sha256=${request[3]}
    url=${request[4]}
    [[ $revision =~ ^[0-9a-f]{40}$ ]]
    [[ $expected_size =~ ^[1-9][0-9]*$ && $expected_size -le $maximum ]]
    [[ $expected_sha256 =~ ^[0-9a-f]{64}$ ]]
    [[ $expected_game_sha256 =~ ^[0-9a-f]{64}$ ]]
    [[ $url =~ ^https://objectstorage\.ap-hyderabad-1\.oraclecloud\.com/p/[^/]+/n/axilpw1vvpzo/b/finals-anvil-deploy-[0-9a-f]{12}/o/anvil-deploy\.bundle$ ]]
    exec 9>/run/finals-anvil-deploy.lock
    flock -n 9
    temporary=$(mktemp /var/tmp/finals-anvil-deploy.XXXXXX)
    trap 'rm -f -- "$temporary"' EXIT
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
      --connect-timeout 10 --max-time 900 --output "$temporary" "$url"
    [[ $(stat -c %s "$temporary") -eq $expected_size ]]
    [[ $(sha256sum "$temporary" | cut -d ' ' -f 1) == "$expected_sha256" ]]
    deploy=$(mktemp /run/finals-anvil-deploy-script.XXXXXX)
    trap 'rm -f -- "$temporary" "$deploy"' EXIT
    tar -xOf "$temporary" deploy.sh > "$deploy"
    chmod 0700 "$deploy"
    [[ $(sha256sum "$deploy" | cut -d ' ' -f 1) == 1af4a291ae6a1fe5e91df27ca1a77f051aa09ba6bfb99bcd498f5e393ac7459d ]]
    ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'sudo -n install -D -o root -g root -m 0600 /dev/stdin /var/tmp/finals-anvil-deploy.bundle' < "$temporary"
    ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'sudo -n install -D -o root -g root -m 0700 /dev/stdin /var/tmp/finals-anvil-deploy.sh' < "$deploy"
    ssh_options=(-F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts)
    if ! output=$(ssh "${ssh_options[@]}" -- "ubuntu@$address" \
      "printf '%s  %s\\n' '1af4a291ae6a1fe5e91df27ca1a77f051aa09ba6bfb99bcd498f5e393ac7459d' /var/tmp/finals-anvil-deploy.sh | sudo -n sha256sum -c --quiet && sudo -n /bin/bash /var/tmp/finals-anvil-deploy.sh '$revision' '$expected_size' '$expected_sha256' '$expected_game_sha256' < /dev/null" 2>&1); then
      printf '%s\n' "$output" >&2
      exit 1
    fi
    printf '%s\n' "$output"
    grep -Fxq "anvil-deploy-revision=$revision" <<< "$output"
    grep -Fxq anvil-deploy=complete <<< "$output"
    echo platform:anvil-deploy=complete
    exit 0
    ;;
  platform:anvil-status)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'set -euo pipefail
      env_file=/etc/anvil/finals.env
      revision=$(sudo -n sed -n "s/^ANVIL_IMAGE_REVISION=//p" "$env_file")
      [[ $revision =~ ^[0-9a-f]{40}$ ]]
      for service in api web ingress; do
        container=$(sudo -n /usr/bin/docker compose --project-name anvil-finals --project-directory /opt/anvil/current/deployments/finals --env-file "$env_file" -f /opt/anvil/current/deployments/finals/compose.yaml ps -q "$service")
        [[ $container =~ ^[0-9a-f]{64}$ ]]
        printf "%s-image=%s\n" "$service" "$(sudo -n /usr/bin/docker inspect --format "{{.Image}}" "$container")"
      done
      printf "env-revision=%s\nanvil-status=complete\n" "$revision"'
    ;;
  control:checker-status)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'set -euo pipefail
      if timeout --signal=TERM --kill-after=2s 10s sudo -n systemctl is-active --quiet checker-runtime.service; then checker_runtime=active; else checker_runtime=inactive; fi
      if timeout --signal=TERM --kill-after=2s 10s sudo -n systemctl is-active --quiet peer-reconciler.timer; then reconciler_timer=active; else reconciler_timer=inactive; fi
      readyz_http=$(curl --silent --output /dev/null --write-out "%{http_code}" --connect-timeout 2 --max-time 3 http://127.0.0.1:9160/readyz || true)
      [[ $readyz_http =~ ^[0-9]{3}$ ]] || readyz_http=000
      printf "checker-runtime.service=%s\npeer-reconciler.timer=%s\nreadyz-http=%s\n" "$checker_runtime" "$reconciler_timer" "$readyz_http"
      [[ $checker_runtime == active && $reconciler_timer == active && $readyz_http == 200 ]]
      echo checker-status=complete'
    ;;
  hill-0[123]:hill-artifacts)
    maximum=385986560
    expected_size=$maximum
    expected_sha256=f3716d884f4ed3ebe5b5c4138d459aa2e35324c0839c5466167d91cd6796cc20
    remote='sudo -n /usr/local/sbin/finals-commission-hill-artifacts'
    directory=/var/tmp
    ;;
  hill-0[123]:hill-config)
    maximum=65536
    expected_size=
    expected_sha256=
    remote='sudo -n /usr/local/sbin/finals-commission-hill-config'
    directory=/run
    ;;
  hill-0[123]:hill-control)
    maximum=65536
    expected_size=
    expected_sha256=
    remote='sudo -n /usr/local/sbin/finals-install-secret-bundle hill-control'
    directory=/run
    ;;
  hill-0[123]:hill-start)
    exec ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
      -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
      -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" \
      'sudo -n /usr/local/sbin/finals-commission-hill-start'
    ;;
  *) exit 2 ;;
esac
temporary=$(mktemp "$directory/finals-runtime-artifact.XXXXXX")
trap 'find "$temporary" -delete' EXIT
head -c "$((maximum + 1))" > "$temporary"
size=$(stat -c %s "$temporary")
(( size > 0 && size <= maximum ))
[[ -z $expected_size || $size -eq $expected_size ]]
[[ -z $expected_sha256 || $(sha256sum "$temporary" | cut -d ' ' -f 1) == "$expected_sha256" ]]
ssh -F /dev/null -i /run/finals-commissioning/central_id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 \
  -o IdentitiesOnly=yes -o PasswordAuthentication=no -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile=/etc/finals-platform/operations/known_hosts -- "ubuntu@$address" "$remote" < "$temporary"
printf '%s:%s=complete\n' "$target" "$action"
