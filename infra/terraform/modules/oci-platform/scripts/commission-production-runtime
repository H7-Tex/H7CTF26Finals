#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 && $(cat /etc/finals-platform/role 2>/dev/null) == '{"role":"operations"}' ]] || exit 1
central=/run/finals-commissioning/central_id_ed25519
[[ -f $central && ! -L $central && $# -eq 0 ]] || exit 2
read -r target action extra
read -r marker host type key extra_key
[[ $target =~ ^production-(0[1-9]|1[0-6])$ && -z ${extra:-} ]] || exit 2
[[ $action == status || $action == proxy-diagnose || $action == docker-store || $action == model-a-network-repair ]] || exit 2
team=$((10#${BASH_REMATCH[1]}))
address="10.60.$team.2"
[[ $marker == known-host && $host == "$address" && $type == ssh-ed25519 && $key =~ ^[A-Za-z0-9+/]{68}$ && -z ${extra_key:-} ]] || exit 1
work=$(mktemp -d /run/finals-production-runtime.XXXXXX)
trap 'rm -rf -- "$work"' EXIT
printf '%s %s %s\n' "$address" "$type" "$key" > "$work/known_hosts"
cat > "$work/remote" <<'REMOTE'
#!/usr/bin/env bash
set -euo pipefail

action=$1
team=$2
if [[ $action == status ]]; then
  if [[ -f /var/lib/finals-model-a/firstboot.done ]]; then echo firstboot.done=yes; else echo firstboot.done=no; fi
  systemctl is-active finals-service-proxy || true
  exit 0
fi

if [[ $action == proxy-diagnose ]]; then
  systemctl show finals-service-proxy.service -p ActiveState,SubState,Result,ExecMainStatus,MainPID
  ss -ltnp | grep -E ':700[1-6][[:space:]]' || :
  nft -a list chain inet finals_host input | grep -E '7001-7006|reject|drop' || :
  journalctl -u finals-service-proxy.service -n 20 --no-pager -o cat
  exit 0
fi

if [[ $action == docker-store ]]; then
  systemctl stop finals-model-a-firstboot.service || true
  python3 - <<'PY'
import json
import os
import stat
import tempfile
from pathlib import Path

path = Path("/etc/docker/daemon.json")
info = path.lstat()
if not stat.S_ISREG(info.st_mode) or info.st_size > 1024 * 1024:
    raise SystemExit("unsafe Docker daemon configuration")
document = json.loads(path.read_text(encoding="utf-8"))
document.setdefault("features", {})["containerd-snapshotter"] = True
with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as output:
    json.dump(document, output, indent=2, sort_keys=True)
    output.write("\n")
    output.flush()
    os.fsync(output.fileno())
    temporary = Path(output.name)
os.chmod(temporary, info.st_mode & 0o777)
os.chown(temporary, info.st_uid, info.st_gid)
os.replace(temporary, path)
PY
  systemctl restart docker
  docker info --format '{{json .DriverStatus}}' | grep -Fq 'io.containerd.snapshotter.v1'
  release=/var/lib/finals-model-a/release
  docker image load --input "$release/archives/base-images.tar" >/dev/null
  python3 - "$release/release.json" <<'PY'
import json
import subprocess
import sys

for record in json.load(open(sys.argv[1], encoding="utf-8"))["base_images"]:
    reference, image_id = record["reference"], record["image_id"]
    repository = reference.split("@", 1)[0]
    subprocess.run(["docker", "tag", image_id, f"{repository}:finals-base"], check=True)
    actual = subprocess.run(
        ["docker", "image", "inspect", "--format", "{{.Id}}", reference],
        check=True, capture_output=True, text=True,
    ).stdout.strip()
    if actual != image_id:
        raise SystemExit(f"base name mismatch {reference}: {actual}")
print("base-names=ok")
PY
  systemctl reset-failed finals-model-a-firstboot.service || true
  systemctl restart --no-block finals-model-a-firstboot.service
  echo 'docker-store=containerd'
  exit 0
fi

[[ $action == model-a-network-repair ]]
[[ -f /var/lib/finals-model-a/firstboot.done ]] || { echo 'model-a-network-repair=refused:firstboot-incomplete' >&2; exit 1; }
[[ $(systemctl show finals-model-a-firstboot -p ActiveState --value) != activating ]] || { echo 'model-a-network-repair=refused:firstboot-active' >&2; exit 1; }
model=/usr/local/lib/finals-model-a/model_a.py
after=23f3b34a0d14c6ab4c8e5df065a4e8dd3fa7bac79e5ed82d5e085910c9b1d2dc
actual=$(sha256sum "$model" | cut -d ' ' -f 1)
if [[ $actual != "$after" ]]; then
  echo "model-a-network-repair=refused:model-hash:$actual" >&2
  exit 1
fi
echo "$after  $model" | sha256sum -c --quiet
for slug in sign-me-in can-we-settle-this update-pending book-me-if-you-can ship-it terms-may-apply; do
  root="/opt/finals/services/$slug"
  image=$(tr -d '\n' < "/var/lib/finals-model-a/active/$slug")
  H7_IMAGE="$image" docker compose --project-directory "$root" --file "$root/compose.yaml" down
  H7_IMAGE="$image" docker compose --project-directory "$root" --file "$root/compose.yaml" up --detach --wait --wait-timeout 90 service
done
unit=/usr/lib/systemd/system/finals-service-proxy.service
unit_original=618f6e50c7aebc8050ec1b0b432ebb0feaa4e3c8e49c1dbbbf203bd9f4e8f0c7
unit_simple=cd6b9eaf22ad90b47840fcf983987e71e9afef08e826c3d6c479069159bf344b
unit_final=7a187147b1f168f3dbd25b7eb921b3b65ef8123a85a9c61f2f33061dacda9be5
unit_actual=$(sha256sum "$unit" | cut -d ' ' -f 1)
if [[ $unit_actual == "$unit_original" || $unit_actual == "$unit_simple" ]]; then
  sed -i -e 's/^Type=notify$/Type=simple/' -e 's#^ExecStart=/usr/sbin/haproxy -Ws #ExecStart=/usr/sbin/haproxy -W -db #' -e 's/^SystemCallFilter=@system-service$/SystemCallFilter=@system-service setuid setgid setgroups/' "$unit"
elif [[ $unit_actual != "$unit_final" ]]; then
  echo "proxy-repair=refused:unit-hash:$unit_actual" >&2
  exit 1
fi
echo "$unit_final  $unit" | sha256sum -c --quiet
systemctl daemon-reload
systemctl restart finals-service-proxy.service
systemctl is-active --quiet finals-service-proxy.service
python3 - "$team" <<'PY'
import http.client
import socket
import sys

team = int(sys.argv[1])
services = (
    ("sign-me-in", 7001, True), ("can-we-settle-this", 7002, True),
    ("update-pending", 7003, False), ("book-me-if-you-can", 7004, True),
    ("ship-it", 7005, True), ("terms-may-apply", 7006, True),
)
failed = False
for slug, port, is_http in services:
    passed = True
    for label, host, target_port in (("loopback", "127.0.0.1", port + 10000),):
        try:
            if is_http:
                connection = http.client.HTTPConnection(host, target_port, timeout=3)
                connection.request("GET", "/")
                response = connection.getresponse()
                response.read(1024)
                connection.close()
                print(f"{slug} {label}=HTTP_{response.status}")
            else:
                with socket.create_connection((host, target_port), timeout=3):
                    pass
                print(f"{slug} {label}=TCP_OK")
        except (OSError, http.client.HTTPException) as error:
            passed = False
            print(f"{slug} {label}=FAIL:{type(error).__name__}")
    print(f"{slug}={'PASS' if passed else 'FAIL'}")
    failed |= not passed
raise SystemExit(1 if failed else 0)
PY
[[ $(ss -ltn | grep -Ec "10\\.60\\.$team\\.2:700[1-6][[:space:]]") -eq 6 ]]
echo 'proxy-listeners=6'
echo 'model-a-network-repair=complete'
REMOTE
chmod 0700 "$work/remote"
ssh -F /dev/null -i "$central" -o BatchMode=yes -o ConnectTimeout=10 -o IdentitiesOnly=yes \
  -o PasswordAuthentication=no -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$work/known_hosts" \
  -- "ubuntu@$address" "sudo -n /bin/bash -s -- '$action' '$team'" < "$work/remote"
