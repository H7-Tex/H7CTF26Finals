#cloud-config
package_update: true
packages:
  - conntrack
  - iproute2
  - nftables
  - python3
  - systemd-timesyncd
  - wireguard-tools
write_files:
%{ for file in files ~}
  - path: /opt/gateway-image/${file.path}
    owner: root:root
    permissions: '${file.permissions}'
    content: |
      ${indent(6, file.content)}
%{ endfor ~}
  - path: /opt/gateway-image/image-manifest.json
    owner: root:root
    permissions: '0644'
    content: |
      {"base_image_id":"${base_image_id}","source_revision":"${source_revision}"}
runcmd:
  - ["/opt/gateway-image/build-image"]
