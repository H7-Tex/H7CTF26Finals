#cloud-config
write_files:
%{ for file in files ~}
  - path: /opt/runtime-image/${file.path}
    owner: root:root
    permissions: '${file.permissions}'
    content: |
      ${indent(6, file.content)}
%{ endfor ~}
  - path: /opt/runtime-image/image-manifest.json
    owner: root:root
    permissions: '0644'
    content: |
      {"base_image_id":"${base_image_id}","role":"${role}","source_revision":"${source_revision}"}
runcmd:
  - ["/opt/runtime-image/build-image", "${role}"]
