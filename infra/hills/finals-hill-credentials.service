[Unit]
Description=Synchronize one Adaptive Hill credential set
Requires=finals-host-firewall.service
After=network-online.target finals-host-firewall.service
Wants=network-online.target
Before=finals-hill.service
ConditionPathExists=/etc/finals-hill/config.json
ConditionPathExists=/etc/finals-hill/anvil.token

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/finals-hill-credentials sync
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/finals-hill
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.60.200.10/32
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=finals-platform.target
